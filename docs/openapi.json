{
  "openapi": "3.0.3",
  "info": {
    "title": "Open WebUI + Ollama API (srv1490900)",
    "version": "0.13.3",
    "description": "Endpoints para iniciar sesion, obtener API key, listar modelos y chatear con llama3.2:3b."
  },
  "servers": [
    {
      "url": "http://srv1490900.hstgr.cloud:3000",
      "description": "Open WebUI en el VPS"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Models"
    },
    {
      "name": "Chat"
    },
    {
      "name": "System"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de sesion (de /api/v1/auths/signin) o API key."
      }
    },
    "schemas": {
      "SigninRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@ejemplo.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "SigninResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "example": "llama3.2:3b"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "stream": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auths/signin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesion",
        "description": "Devuelve el token Bearer para usar en los demas endpoints.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigninRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesion iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigninResponse"
                }
              }
            }
          },
          "400": {
            "description": "Credenciales invalidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auths/api_key": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Obtener API key",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "API key actual"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      },
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Crear API key",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "API key creada"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Eliminar API key",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "API key eliminada"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "Listar modelos disponibles",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de modelos (incluye llama3.2:3b)"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/api/chat/completions": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Enviar mensaje al modelo",
        "description": "Formato compatible con OpenAI. Envia el historial en messages y recibe la respuesta del modelo.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "example": {
                "model": "llama3.2:3b",
                "messages": [
                  {
                    "role": "user",
                    "content": "Hola, quien eres?"
                  }
                ],
                "stream": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta del modelo"
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Modelo no encontrado"
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Version de Open WebUI",
        "responses": {
          "200": {
            "description": "Version del servicio"
          }
        }
      }
    }
  }
}